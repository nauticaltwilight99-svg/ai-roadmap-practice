# AI provider
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:4b
OLLAMA_SMART_MODEL=qwen3:8b
OLLAMA_NUM_PREDICT=192
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.2
# Direct Telegram transport
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
# Optional comma-separated allowlist, for example: 123456789
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_OWNER_CHAT_ID=0
TELEGRAM_MEMORY_DB=.runtime/telegram_memory.sqlite3
WORKER_POLL_SECONDS=10

# Brevo Free: keep empty until the account and sender are verified
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FDA Solutions: First Design Aid for HoReCa & more
BREVO_TIMEOUT=30
BREVO_CONTACT_LIST_ID=
PUBLIC_DASHBOARD_URL=
PAYMENT_URL=
PAYMENT_PHONE=
PAYMENT_RECIPIENT=
PAYMENT_PURPOSE=FDA Solutions — сайт и демо
AUTO_ACTION_MODE=dry_run
AUTO_APPROVE_CRM=1
BREVO_AUTO_CRM=1

# Dashboard login
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-long-random-password